# Copie para .env e ajuste. NUNCA commite o .env.
# ---------- Geral ----------
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=8080
LOG_LEVEL=info

# ---------- MongoDB ----------
MONGO_INITDB_ROOT_USERNAME=helpeme
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo
MONGO_DB_NAME=helpeme
MONGODB_URI=mongodb://helpeme:change-me-mongo@mongo:27017/helpeme?authSource=admin

# ---------- Auth ----------
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
COOKIE_SECURE=false
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:8080
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ---------- Seed (admin root exigido pelo desafio) ----------
RUN_SEED=true
ADMIN_ROOT_NAME=Admin Root
ADMIN_ROOT_EMAIL=admin@admin.com
ADMIN_ROOT_PASSWORD=Admin123@
# Usuário de teste (opcional; defina as três ou nenhuma)
SEED_USER_NAME=Jose da Silva
SEED_USER_EMAIL=user@test.com
SEED_USER_PASSWORD=User123@

# ---------- Upload / paginação ----------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_FILES_PER_REQUEST=5
PAGINATION_MAX_LIMIT=50

# ---------- Frontend ----------
VITE_API_BASE_URL=/api
